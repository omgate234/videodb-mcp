# REQUIRED — secret used to encrypt OAuth tokens (the server is stateless: user API
# keys travel inside AES-256-GCM-encrypted tokens instead of a database).
# Generate one with:  openssl rand -hex 32
# Rotating this value invalidates all existing connections (users just reconnect).
AUTH_SECRET=

# Optional — VideoDB API base URL. Defaults to the production API.
# VIDEODB_API_BASE=https://api.videodb.io

# Optional — DirectorFE login bridge. Set BOTH to replace the "paste your API
# key" consent page with a VideoDB sign-in. Leave unset to keep the built-in
# consent page (still the path for accounts with an API key but no login).
# DIRECTORFE_ORIGIN=https://console.videodb.io
#
# Shared with DirectorFE; authenticates its server-to-server callback. The
# req_token travels through the browser, so this secret is what stops a stolen
# one from being redeemed. Generate with:  openssl rand -hex 32
# DIRECTORFE_BRIDGE_SECRET=

# Optional — which toolsets /mcp exposes. Comma list of names from docs/TOOLSETS.md
# (collections, media, transcripts, indexing, search, streams, editor, rtstream,
# meetings) or "all". Unset → every toolset marked default-on, which is
# currently all of them.
# VIDEODB_MCP_TOOLSETS=all

# Optional — per-tool-call budget in ms before a slow VideoDB call is handed back
# as {status:"processing"}. MCP clients drop a call at ~60s, so keep this under
# that; long jobs never wait (they return an output_url for get_job_result).
# TOOL_DEADLINE_MS=50000

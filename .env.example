# REQUIRED — secret used to encrypt OAuth tokens (the server is stateless: user API
# keys travel inside AES-256-GCM-encrypted tokens instead of a database).
# Generate one with:  openssl rand -hex 32
# Rotating this value invalidates all existing connections (users just reconnect).
AUTH_SECRET=

# Optional — VideoDB API base URL. Defaults to the production API.
# VIDEODB_API_BASE=https://api.videodb.io
